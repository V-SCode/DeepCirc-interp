# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
# macOS AppleDouble resource-fork sidecars (scattered by Finder on
# non-APFS volumes; produce "non-monotonic index" git warnings on *.pack.idx
# files and clutter listings).
._*

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- Virtual environments ---
.venv/
.venv_*/
venv/
env/

# --- Generated panel outputs (regenerable from scripts) ---
figures/setFinal/*/panels/raster/*.png
figures/setFinal/*/panels/vector/*.pdf
figures/setFinal/*/panels/vector/*.svg
figures/setFinal/*/final/*.pdf
figures/setFinal/*/final/*.png
figures/setFinal/*/final/*.linked_assets.json
figures/setFinal/*/preview/contact_sheet.png

# Same for the setFinalvF (v1.1) figures; the tables (tabS0*/final/*)
# are shipped deliverables and intentionally tracked.
figures/setFinalvF/fig*/panels/raster/*.png
figures/setFinalvF/fig*/panels/vector/*.pdf
figures/setFinalvF/fig*/panels/vector/*.svg
figures/setFinalvF/fig*/final/*.pdf
figures/setFinalvF/fig*/final/*.png
figures/setFinalvF/fig*/final/*.linked_assets.json
figures/setFinalvF/fig*/preview/contact_sheet.png

# --- Large data — fetched from Zenodo, not tracked here ---
data/exemplars/0x*_design/
data/topology_g3/predictions/
data/topology_g3/mlp_checkpoints/
data/topology_g3/registries/
data/topology_g3/landscape_*.parquet
data/topology_g3/motif_catalog_*.json
data/interp_processed/global_landscape_*.parquet
data/interp_processed/master_*.parquet

